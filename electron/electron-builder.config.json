{
  "appId": "com.kfi.app",
  "productName": "KFI",
  "directories": {
    "output": "dist",
    "buildResources": "resources"
  },
  "files": [
    "build/**/*",
    "capacitor.config.json",
    "app/**/*"
  ],
  "nsis": {
    "allowElevation": true,
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "mac": {
    "category": "your.app.category.type",
    "target": "dmg"
  }
}
