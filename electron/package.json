{
  "name": "kfi",
  "version": "1.0.0",
  "description": "KFI Electron App",
  "main": "build/src/index.js",
  "scripts": {
    "electron:start": "electron . --no-sandbox",
    "electron:build": "npm run build && electron-builder build -c ./electron-builder.config.json",
    "electron:build-windows": "npm run build && electron-builder build --win -c ./electron-builder.config.json",
    "build": "electron-rebuild"
  },
  "dependencies": {
    "@capacitor-community/electron": "5.0.1",
    "@capacitor/core": "5.7.2",
    "chokidar": "^3.5.3",
    "electron-is-dev": "^2.0.0",
    "electron-serve": "^1.3.0",
    "electron-unhandled": "^4.0.1",
    "electron-window-state": "^5.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.4.0",
    "electron": "26.6.10",
    "electron-builder": "^24.0.0",
    "typescript": "^5.0.0"
  }
}
